# 统一换行符：KernelSU/Magisk 模块脚本必须 LF，
# 带 CRLF 会导致 Android 上 "bad interpreter" 直接跑不起来。
* text=auto eol=lf

# 明确指定必须 LF 的类型
*.sh            text eol=lf
*.prop          text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf

# 二进制/不应做换行转换
*.png           binary
*.jpg           binary
*.zip           binary

# GitHub 语言统计：把 shell 脚本认作 Shell
*.sh            linguist-language=Shell

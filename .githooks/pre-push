#!/bin/sh
# pre-push：推送前做最终把关
#   1) 完整校验（含版本一致性，比 pre-commit 更全）
#   2) 提示 versionCode 是否需要递增
# 安装在 .githooks/ 下，通过 git config core.hooksPath .githooks 生效
#
# 紧急跳过：git push --no-verify
set -u

ROOT=$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)

if [ ! -x "$ROOT/scripts/verify.sh" ]; then
  echo "pre-push: 找不到 scripts/verify.sh，跳过检查" >&2
  exit 0
fi

echo "pre-push: 运行完整校验..."
if ! "$ROOT/scripts/verify.sh"; then
  echo >&2
  echo "pre-push: 校验未通过，已阻止推送。" >&2
  echo "          确认无问题可用 git push --no-verify 强制推送（CI 仍会检查）。" >&2
  exit 1
fi

# 提醒：module.prop 改了但 versionCode 没动的情形
if command -v git >/dev/null 2>&1; then
  _changed=$(git -C "$ROOT" diff --name-only "@{upstream}..HEAD" 2>/dev/null | grep -c '^module.prop$' || true)
  if [ "${_changed:-0}" -gt 0 ]; then
    _vc=$(sed -n 's/^versionCode=//p' "$ROOT/module.prop" | head -1)
    _old=$(git -C "$ROOT" show "@{upstream}:module.prop" 2>/dev/null | sed -n 's/^versionCode=//p' | head -1)
    if [ -n "$_old" ] && [ "$_vc" = "$_old" ]; then
      echo >&2
      echo "提醒: module.prop 有改动，但 versionCode 仍为 $_vc（未递增）。" >&2
      echo "      模块管理器靠 versionCode 判断更新，请确认是否需要 +1。" >&2
    fi
  fi
fi

exit 0
